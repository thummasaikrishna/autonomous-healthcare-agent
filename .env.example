# Copy this file to .env and fill in real values.
# Nothing here is a real secret.

# --- General ---
APP_ENV=development
DEMO_MODE=false

# --- LLM provider ---
# Supported: groq, anthropic
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- PubMed / NCBI E-utilities ---
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# NCBI asks that you identify requests with a contact email.
PUBMED_EMAIL=your-email@example.com
PUBMED_TOOL_NAME=autonomous-healthcare-agent
# Optional but recommended: raises your NCBI rate limit.
PUBMED_API_KEY=
PUBMED_MAX_RESULTS=6
PUBMED_TIMEOUT_SECONDS=15
PUBMED_MAX_RETRIES=2

# --- Embeddings ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=clinical_documents
RETRIEVAL_TOP_K=5

# --- Chunking ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- PDF source directory ---
PDF_SOURCE_DIR=./data/pdfs

# --- Database ---
DATABASE_URL=sqlite:///./data/app.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./data/app.log
